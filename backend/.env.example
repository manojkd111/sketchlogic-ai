# Copy to backend/.env. All variables are optional; defaults shown.
SKETCHLOGIC_ENVIRONMENT=development
# JSON list of allowed browser origins.
SKETCHLOGIC_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
SKETCHLOGIC_DATA_DIR=var
SKETCHLOGIC_MAX_UPLOAD_BYTES=10485760

# Inference provider: mock | local | bedrock
SKETCHLOGIC_INFERENCE_PROVIDER=mock

# AWS is DISABLED by default. Do not enable without explicit approval (see CLAUDE.md).
SKETCHLOGIC_AWS_ENABLED=false
# SKETCHLOGIC_AWS_REGION=us-east-1
